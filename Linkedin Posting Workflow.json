    {
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 24 * 60 * 60 * 1000;\n\nreturn $input.all().filter(item => {\n  const published = item.json.published;\n  const timestamp = Date.parse(published);\n\n  return !isNaN(timestamp) && timestamp >= cutoff;\n});"
      },
      "id": "3cdb9053-fad3-4c93-9736-a3e31b8a7b69",
      "name": "Keep Last 24 Hours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    ...item.json,\n    relevancePrompt: `You are a news relevance classifier.\\n\\nTarget topics: AI, generative AI, data engineering, analytics, automation, marketing technology, and AI agents.\\n\\nArticle title: ${item.json.title}\\nSummary: ${item.json.summary}\\nSource: ${item.json.source}\\nURL: ${item.json.url}\\n\\nReturn ONLY JSON in this format: {\"relevant\":true,\"reason\":\"short reason\"}. Mark relevant only when the story is genuinely useful for a professional audience interested in the target topics.`\n  }\n}));"
      },
      "id": "ccabcfed-2e68-4961-9eb7-9bf80dd61b29",
      "name": "Build Relevance Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json.text || '';\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch {\n  parsed = {relevant:false, reason:'Could not parse classifier output'};\n}\nconst original = $('Build Relevance Prompt').item.json;\nreturn [{json:{...original, relevant:Boolean(parsed.relevant), relevanceReason:parsed.reason || ''}}];"
      },
      "id": "f7bfa130-b35d-4be6-bddc-5281d22cb7b2",
      "name": "Parse Relevance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1c03b999-b816-4288-ab48-dd109f7f0768",
              "leftValue": "={{ $json.relevant }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "639fd5ab-d3ac-454c-9348-25761b679468",
      "name": "Relevant?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1712,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    ...$json,\n    draftPrompt: `You are a social media content strategist. Create a draft social post from the article below.\n\nBrand voice:\n- Practical, clear, confident, and human\n- Teach something useful before mentioning any opinion\n- Avoid hype, clickbait, and unsupported claims\n- Do not copy the source article\n- Keep the post concise enough for LinkedIn\n- Include a short hook, 3-5 useful points, and a closing question\n- Include the source URL at the end\n\nArticle:\nTitle: ${$json.title}\nSummary: ${$json.summary}\nSource: ${$json.source}\nURL: ${$json.url}\n\nReturn ONLY JSON:\n{\"post\":\"...\",\"hook\":\"...\",\"sourceUrl\":\"${$json.url}\"}`\n  }\n}];"
      },
      "id": "cfa5da2b-4834-4b90-8063-ef8dce05feb9",
      "name": "Build Draft Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -112
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json.text || '';\nlet draft;\ntry { draft = typeof raw === 'string' ? JSON.parse(raw) : raw; }\ncatch { draft = {post: raw, hook: '', sourceUrl: $('Build Draft Prompt').item.json.url}; }\nconst source = $('Build Draft Prompt').item.json;\nreturn [{json:{...source, post:draft.post || '', hook:draft.hook || '', sourceUrl:draft.sourceUrl || source.url}}];"
      },
      "id": "5bef2cb2-27eb-453a-bf93-a6e22e3f5614",
      "name": "Parse Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2384,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $json.post || '';\nconst html = `<h2>AI Social Post — Human Review Required</h2>\n<p><b>Source:</b> ${$json.source}</p>\n<p><b>Article:</b> <a href=\"${$json.url}\">${$json.title}</a></p>\n<hr>\n<p>${p.replace(/\\n/g,'<br>')}</p>\n<hr>\n<p><b>Relevance:</b> ${$json.relevanceReason || 'Relevant to the selected topics.'}</p>\n<p>Approve only if the facts, framing, and brand voice look right.</p>`;\nreturn [{json:{...$json, approvalSubject:`Approve social post: ${$json.title}`, approvalHtml:html}}];"
      },
      "id": "d269b8c0-d606-4df0-8d36-15deda210db5",
      "name": "Build Approval Email",
      "type": "n8n-nodes-base.code",
